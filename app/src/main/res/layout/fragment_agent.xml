<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_bg">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="@dimen/dp_20">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/agent_title"
                android:textColor="@color/color_text"
                android:textSize="@dimen/sp_22"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_connected"
                android:paddingHorizontal="@dimen/dp_10"
                android:paddingVertical="@dimen/dp_4"
                android:text="@string/agent_status_online"
                android:textColor="@color/color_bg"
                android:textSize="@dimen/sp_12"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_robot_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_20"
            android:layout_marginBottom="@dimen/dp_8"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/color_text_muted"
            android:textSize="@dimen/sp_13" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_20"
            android:layout_marginBottom="@dimen/dp_12"
            android:text="@string/agent_hint"
            android:textColor="@color/color_text_muted"
            android:textSize="@dimen/sp_13" />

        <ScrollView
            android:id="@+id/scroll_messages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/dp_20">

            <LinearLayout
                android:id="@+id/container_messages"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:paddingHorizontal="@dimen/dp_20"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_quick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true" />
        </HorizontalScrollView>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/dp_20"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/et_input"
                android:layout_width="0dp"
                android:layout_height="@dimen/min_touch_target"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:hint="@string/agent_input_hint"
                android:paddingHorizontal="@dimen/dp_14"
                android:textColor="@color/color_text"
                android:textColorHint="@color/color_text_muted"
                android:textSize="@dimen/sp_15" />

            <TextView
                android:id="@+id/btn_send"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/min_touch_target"
                android:layout_marginStart="@dimen/dp_8"
                android:minWidth="@dimen/min_touch_target"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_btn_primary"
                android:paddingHorizontal="@dimen/dp_16"
                android:text="@string/agent_btn_send"
                android:textColor="@color/color_bg"
                android:textSize="@dimen/sp_15"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_voice"
                android:layout_width="@dimen/min_touch_target"
                android:layout_height="@dimen/min_touch_target"
                android:layout_marginStart="@dimen/dp_8"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_btn_outline"
                android:contentDescription="@string/cd_agent_voice_btn"
                android:text="🎤"
                android:textSize="@dimen/sp_18" />
        </LinearLayout>
    </LinearLayout>
</layout>
