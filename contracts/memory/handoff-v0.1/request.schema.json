{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboguide.local/contracts/memory/handoff-v0.1/request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "parent_selector",
    "child",
    "source_group_id",
    "source_membership",
    "source_execution_ids",
    "target_membership",
    "registry_id",
    "registry_revision",
    "deadline_ms"
  ],
  "properties": {
    "schema_version": {
      "const": "roboguide.memory-handoff/v0.1"
    },
    "handoff_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "parent_selector": {
      "$ref": "#/$defs/selector"
    },
    "child": {
      "allOf": [
        {
          "$ref": "../preparation-v0.2/preparation.schema.json#/$defs/manifest"
        },
        {
          "properties": {
            "scope": {
              "properties": {
                "kind": {
                  "const": "execution_group"
                }
              },
              "required": [
                "kind",
                "execution_group_id"
              ]
            },
            "kind": {
              "not": {
                "const": "spatial"
              }
            },
            "visibility": {
              "const": "exchangeable"
            }
          }
        }
      ]
    },
    "source_group_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_membership": {
      "$ref": "#/$defs/membership"
    },
    "source_execution_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "target_membership": {
      "$ref": "#/$defs/membership"
    },
    "registry_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "registry_revision": {
      "type": "integer",
      "minimum": 1
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_id",
        "revision_id"
      ],
      "properties": {
        "memory_id": {
          "type": "string",
          "minLength": 1
        },
        "revision_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "bindings_digest"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "bindings_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
