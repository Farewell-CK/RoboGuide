{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboguide.local/contracts/memory/use-query-v0.1/query.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "roboguide.memory-use-query/v0.1"
    },
    "query_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "command_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "provider_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "opened_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "session_budget_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "valid_for_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000
    }
  },
  "required": [
    "schema",
    "query_id",
    "command_id",
    "command_digest",
    "generation",
    "provider_ids",
    "opened_at_ms",
    "session_budget_ms",
    "valid_for_ms"
  ]
}
