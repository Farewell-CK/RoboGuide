{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboguide.local/contracts/memory/use-query-v0.1/receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "roboguide.memory-use-query-receipt/v0.1"
    },
    "query_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "query_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "enum": [
              "confirmed",
              "unknown",
              "not_issued",
              "conflict"
            ]
          },
          "proof": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "provider_id",
                  "provider_instance_id",
                  "provider_contract_digest",
                  "import_ids",
                  "receipt_digest",
                  "original_receipt"
                ],
                "properties": {
                  "provider_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "provider_instance_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "provider_contract_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "import_ids": {
                    "type": "array",
                    "maxItems": 8,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "receipt_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "original_receipt": {
                    "type": "object",
                    "maxProperties": 32,
                    "description": "Opaque exact local-profile receipt; Node validates the negotiated profile before admitting it. Core checks canonical digest and a 16 KiB bound."
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "required": [
          "provider_id",
          "status",
          "proof",
          "reason"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "confirmed"
                }
              }
            },
            "then": {
              "properties": {
                "proof": {
                  "type": "object"
                }
              }
            },
            "else": {
              "properties": {
                "proof": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "query_id",
    "query_digest",
    "observations"
  ]
}
