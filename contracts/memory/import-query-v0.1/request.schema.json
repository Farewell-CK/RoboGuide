{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboguide.local/contracts/memory/import-query-v0.1/request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "import_id",
    "expected_generation",
    "deadline_ms",
    "query_timeout_ms"
  ],
  "properties": {
    "import_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expected_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 1
    },
    "query_timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000
    }
  }
}
