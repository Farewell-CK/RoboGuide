{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboguide.local/contracts/capability/v0.2/catalog.schema.json",
  "title": "RoboGuide Canonical Capability Catalog v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capabilities", "operations"],
  "properties": {
    "schema_version": {"const": "roboguide.capability-catalog/v0.2"},
    "capabilities": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/capability"}},
    "operations": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/operation"}}
  },
  "$defs": {
    "ref": {
      "type":"object","additionalProperties":false,"required":["namespace","name","version"],
      "properties":{"namespace":{"type":"string","minLength":1},"name":{"type":"string","minLength":1},"version":{"type":"string","minLength":1}}
    },
    "typed_field": {
      "type":"object","additionalProperties":false,"required":["name","type","description"],
      "properties":{"name":{"type":"string","minLength":1},"type":{"enum":["boolean","integer","number","string"]},"description":{"type":"string","minLength":1}}
    },
    "parameter": {
      "type":"object","additionalProperties":false,"required":["name","type","required","description"],
      "properties":{"name":{"type":"string","minLength":1},"type":{"enum":["boolean","integer","number","string"]},"required":{"type":"boolean"},"description":{"type":"string","minLength":1}}
    },
    "capability": {
      "type":"object","additionalProperties":false,"required":["contract","description","attributes"],
      "properties":{"contract":{"$ref":"#/$defs/ref"},"description":{"type":"string","minLength":1},"attributes":{"type":"array","items":{"$ref":"#/$defs/typed_field"}}}
    },
    "operation": {
      "type":"object","additionalProperties":false,"required":["operation","description","parameters","required_capabilities"],
      "properties":{"operation":{"$ref":"#/$defs/ref"},"description":{"type":"string","minLength":1},"parameters":{"type":"array","items":{"$ref":"#/$defs/parameter"}},"required_capabilities":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/ref"}}}
    }
  }
}
