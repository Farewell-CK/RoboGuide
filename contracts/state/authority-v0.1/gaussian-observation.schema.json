{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mean",
    "covariance",
    "unit",
    "frame"
  ],
  "properties": {
    "mean": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "number"
      }
    },
    "covariance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": {
          "type": "number"
        }
      }
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "frame": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "$defs": {
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "node_id",
            "local_system_id"
          ],
          "properties": {
            "owner": {
              "const": "node"
            },
            "node_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "local_system_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "component"
          ],
          "properties": {
            "owner": {
              "const": "robo_guide"
            },
            "component": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      ]
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "object_type",
        "object_id"
      ],
      "properties": {
        "class": {
          "enum": [
            "node",
            "world",
            "robo_guide"
          ]
        },
        "object_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "object_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "name",
        "version"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "decision_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "policy_id",
        "revision",
        "object",
        "channel_id",
        "allowed_semantics",
        "allowed_sources",
        "max_age_ms",
        "min_confidence_millionths",
        "allowed_decisions",
        "reducer",
        "payload_schema"
      ],
      "properties": {
        "schema": {
          "const": "roboguide.decision-evidence-policy/v0.1"
        },
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "object": {
          "$ref": "#/$defs/object"
        },
        "channel_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "allowed_semantics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "desired",
              "committed",
              "reported",
              "observed",
              "derived",
              "belief"
            ]
          }
        },
        "allowed_sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "max_age_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "min_confidence_millionths": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000
        },
        "allowed_decisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "match",
              "commit",
              "bind",
              "rebind",
              "readiness",
              "satisfaction",
              "belief_fusion"
            ]
          }
        },
        "reducer": {
          "enum": [
            "require_equivalent",
            "highest_confidence"
          ]
        },
        "payload_schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
