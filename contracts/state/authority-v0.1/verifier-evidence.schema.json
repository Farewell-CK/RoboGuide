{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "source_id",
    "source_revision",
    "tenant_id",
    "task_ref",
    "plan_digest",
    "attempts",
    "predicate",
    "verdict",
    "finality",
    "source_observed_at_ms",
    "valid_for_ms",
    "sequence",
    "artifact_digest",
    "artifact_size_bytes"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "task_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_id",
        "task_id"
      ],
      "properties": {
        "mission_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role_id",
          "attempt_id"
        ],
        "properties": {
          "role_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "attempt_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "predicate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "verdict": {
      "enum": [
        "satisfied",
        "unsatisfied",
        "unknown"
      ]
    },
    "finality": {
      "enum": [
        "provisional",
        "final"
      ]
    },
    "source_observed_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "valid_for_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "artifact_digest": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_size_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 67108864
    }
  },
  "$defs": {
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "node_id",
            "local_system_id"
          ],
          "properties": {
            "owner": {
              "const": "node"
            },
            "node_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "local_system_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "component"
          ],
          "properties": {
            "owner": {
              "const": "robo_guide"
            },
            "component": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      ]
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "object_type",
        "object_id"
      ],
      "properties": {
        "class": {
          "enum": [
            "node",
            "world",
            "robo_guide"
          ]
        },
        "object_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "object_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "name",
        "version"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "decision_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "policy_id",
        "revision",
        "object",
        "channel_id",
        "allowed_semantics",
        "allowed_sources",
        "max_age_ms",
        "min_confidence_millionths",
        "allowed_decisions",
        "reducer",
        "payload_schema"
      ],
      "properties": {
        "schema": {
          "const": "roboguide.decision-evidence-policy/v0.1"
        },
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "object": {
          "$ref": "#/$defs/object"
        },
        "channel_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "allowed_semantics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "desired",
              "committed",
              "reported",
              "observed",
              "derived",
              "belief"
            ]
          }
        },
        "allowed_sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "max_age_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "min_confidence_millionths": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000
        },
        "allowed_decisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "match",
              "commit",
              "bind",
              "rebind",
              "readiness",
              "satisfaction",
              "belief_fusion"
            ]
          }
        },
        "reducer": {
          "enum": [
            "require_equivalent",
            "highest_confidence"
          ]
        },
        "payload_schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
