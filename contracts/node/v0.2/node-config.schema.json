{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboguide.local/contracts/node/v0.2/node-config.schema.json",
  "title": "RoboGuide Node Service configuration v0.2",
  "description": "Strict declarative configuration for one roboguide-node process and its local integration workflows.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "node_id",
    "server_endpoint",
    "state_directory",
    "local_systems",
    "connections",
    "capabilities"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "roboguide.node-config/v0.2"
    },
    "node_id": {
      "$ref": "#/$defs/nonBlankString"
    },
    "server_endpoint": {
      "type": "string",
      "minLength": 1
    },
    "state_directory": {
      "type": "string",
      "minLength": 1
    },
    "reconnect_delay_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615,
      "default": 1000
    },
    "local_systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/localSystem"
      }
    },
    "connections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/connection"
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "resources": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "sensors": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/sensor"
      }
    }
  },
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "jsonPointer": {
      "type": "string",
      "pattern": "^(?:|(?:/(?:[^~/]|~[01])*)+)$"
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "localSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "runtime_name",
        "runtime_version",
        "health"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonBlankString"
        },
        "runtime_name": {
          "$ref": "#/$defs/nonBlankString"
        },
        "runtime_version": {
          "$ref": "#/$defs/nonBlankString"
        },
        "health": {
          "$ref": "#/$defs/localSystemHealth"
        },
        "metadata": {
          "$ref": "#/$defs/stringMap",
          "default": {}
        }
      }
    },
    "localSystemHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "state_pointer",
        "online",
        "degraded",
        "offline"
      ],
      "properties": {
        "step": {
          "$ref": "#/$defs/workflowStep"
        },
        "state_pointer": {
          "$ref": "#/$defs/jsonPointer"
        },
        "detail_pointer": {
          "anyOf": [
            {
              "$ref": "#/$defs/jsonPointer"
            },
            {
              "type": "null"
            }
          ]
        },
        "online": {
          "$ref": "#/$defs/nonEmptyStateValues"
        },
        "degraded": {
          "$ref": "#/$defs/nonEmptyStateValues"
        },
        "offline": {
          "$ref": "#/$defs/nonEmptyStateValues"
        },
        "case_sensitive": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "credentialSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "env"
      ],
      "properties": {
        "env": {
          "$ref": "#/$defs/nonBlankString"
        }
      }
    },
    "credentialMap": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/nonBlankString"
      },
      "additionalProperties": {
        "$ref": "#/$defs/credentialSource"
      }
    },
    "connection": {
      "oneOf": [
        {
          "$ref": "#/$defs/httpConnection"
        },
        {
          "$ref": "#/$defs/grpcConnection"
        },
        {
          "$ref": "#/$defs/mcpConnection"
        }
      ]
    },
    "httpConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "driver",
        "id",
        "local_system",
        "endpoint"
      ],
      "properties": {
        "driver": {
          "const": "http"
        },
        "id": {
          "$ref": "#/$defs/nonBlankString"
        },
        "local_system": {
          "$ref": "#/$defs/nonBlankString"
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615,
          "default": 5000
        },
        "headers": {
          "$ref": "#/$defs/credentialMap",
          "default": {}
        }
      }
    },
    "grpcConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "driver",
        "id",
        "local_system",
        "endpoint"
      ],
      "properties": {
        "driver": {
          "const": "grpc"
        },
        "id": {
          "$ref": "#/$defs/nonBlankString"
        },
        "local_system": {
          "$ref": "#/$defs/nonBlankString"
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "descriptor_set": {
          "type": [
            "string",
            "null"
          ]
        },
        "reflection": {
          "type": "boolean",
          "default": false
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615,
          "default": 5000
        },
        "metadata": {
          "$ref": "#/$defs/credentialMap",
          "default": {}
        }
      },
      "oneOf": [
        {
          "required": [
            "descriptor_set"
          ],
          "properties": {
            "descriptor_set": {
              "type": "string",
              "minLength": 1
            },
            "reflection": {
              "const": false
            }
          }
        },
        {
          "required": [
            "reflection"
          ],
          "properties": {
            "descriptor_set": {
              "type": "null"
            },
            "reflection": {
              "const": true
            }
          }
        }
      ]
    },
    "mcpConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "driver",
        "id",
        "local_system",
        "endpoint"
      ],
      "properties": {
        "driver": {
          "const": "mcp"
        },
        "id": {
          "$ref": "#/$defs/nonBlankString"
        },
        "local_system": {
          "$ref": "#/$defs/nonBlankString"
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615,
          "default": 5000
        },
        "headers": {
          "$ref": "#/$defs/credentialMap",
          "default": {}
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "kind",
        "owner",
        "workflow"
      ],
      "properties": {
        "contract": {
          "type": "string",
          "minLength": 5,
          "pattern": "^.+\\..+@[^@]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "mobility",
            "transport",
            "compute",
            "observation"
          ]
        },
        "owner": {
          "$ref": "#/$defs/nonBlankString"
        },
        "required_resources": {
          "type": "array",
          "default": [],
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonBlankString"
          }
        },
        "local_locks": {
          "type": "array",
          "default": [],
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonBlankString"
          }
        },
        "workflow": {
          "$ref": "#/$defs/workflow"
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execute",
        "status",
        "cancel",
        "local_handle",
        "execution_state"
      ],
      "properties": {
        "execute": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/workflowStep"
          }
        },
        "status": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/workflowStep"
          }
        },
        "cancel": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/workflowStep"
          }
        },
        "local_handle": {
          "$ref": "#/$defs/valueExpression"
        },
        "poll_interval_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615,
          "default": 250
        },
        "execution_state": {
          "$ref": "#/$defs/executionState"
        }
      }
    },
    "workflowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "connection",
        "operation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonBlankString"
        },
        "connection": {
          "$ref": "#/$defs/nonBlankString"
        },
        "operation": {
          "$ref": "#/$defs/localOperation"
        },
        "request": {
          "$ref": "#/$defs/requestMapping",
          "default": {
            "base": {},
            "bindings": []
          }
        }
      }
    },
    "localOperation": {
      "oneOf": [
        {
          "$ref": "#/$defs/httpOperation"
        },
        {
          "$ref": "#/$defs/grpcUnaryOperation"
        },
        {
          "$ref": "#/$defs/grpcServerStreamOperation"
        },
        {
          "$ref": "#/$defs/mcpToolOperation"
        }
      ]
    },
    "httpOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "method",
        "path"
      ],
      "properties": {
        "kind": {
          "const": "http"
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/",
          "not": {
            "pattern": "[{}$?#]|\\.\\."
          }
        }
      }
    },
    "grpcUnaryOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "service",
        "method"
      ],
      "properties": {
        "kind": {
          "const": "grpc_unary"
        },
        "service": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.\\-/]+$"
        },
        "method": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+$"
        }
      }
    },
    "grpcServerStreamOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "service",
        "method"
      ],
      "properties": {
        "kind": {
          "const": "grpc_server_stream"
        },
        "service": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.\\-/]+$"
        },
        "method": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+$"
        }
      }
    },
    "mcpToolOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "tool"
      ],
      "properties": {
        "kind": {
          "const": "mcp_tool"
        },
        "tool": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.\\-/]+$"
        }
      }
    },
    "requestMapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": {
          "default": {}
        },
        "bindings": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/requestBinding"
          }
        }
      }
    },
    "requestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "value"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/jsonPointer"
        },
        "value": {
          "$ref": "#/$defs/valueExpression"
        }
      }
    },
    "valueExpression": {
      "oneOf": [
        {
          "$ref": "#/$defs/pointerExpression"
        },
        {
          "$ref": "#/$defs/constantExpression"
        },
        {
          "$ref": "#/$defs/functionExpression"
        }
      ]
    },
    "pointerExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "pointer"
      ],
      "properties": {
        "kind": {
          "const": "pointer"
        },
        "pointer": {
          "$ref": "#/$defs/jsonPointer"
        }
      }
    },
    "constantExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "constant"
        },
        "value": {}
      }
    },
    "functionExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "function",
        "arguments"
      ],
      "properties": {
        "kind": {
          "const": "function"
        },
        "function": {
          "type": "string",
          "enum": [
            "to_string",
            "to_integer",
            "to_float",
            "to_boolean",
            "quaternion_from_yaw"
          ]
        },
        "arguments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/valueExpression"
          }
        }
      }
    },
    "executionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_pointer",
        "running",
        "completed",
        "failed",
        "cancelled"
      ],
      "properties": {
        "state_pointer": {
          "$ref": "#/$defs/jsonPointer"
        },
        "reason_pointer": {
          "anyOf": [
            {
              "$ref": "#/$defs/jsonPointer"
            },
            {
              "type": "null"
            }
          ]
        },
        "accepted": {
          "$ref": "#/$defs/stateValues",
          "default": []
        },
        "running": {
          "$ref": "#/$defs/nonEmptyStateValues"
        },
        "completed": {
          "$ref": "#/$defs/nonEmptyStateValues"
        },
        "failed": {
          "$ref": "#/$defs/nonEmptyStateValues"
        },
        "cancelled": {
          "$ref": "#/$defs/nonEmptyStateValues"
        },
        "case_sensitive": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "stateValues": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonBlankString"
      }
    },
    "nonEmptyStateValues": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonBlankString"
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "capacity",
        "owner"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonBlankString"
        },
        "kind": {
          "type": "string",
          "enum": [
            "space",
            "compute",
            "time"
          ]
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "owner": {
          "$ref": "#/$defs/nonBlankString"
        },
        "metadata": {
          "$ref": "#/$defs/stringMap",
          "default": {}
        }
      }
    },
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "owner"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonBlankString"
        },
        "kind": {
          "$ref": "#/$defs/nonBlankString"
        },
        "owner": {
          "$ref": "#/$defs/nonBlankString"
        },
        "metadata": {
          "$ref": "#/$defs/stringMap",
          "default": {}
        }
      }
    }
  }
}
