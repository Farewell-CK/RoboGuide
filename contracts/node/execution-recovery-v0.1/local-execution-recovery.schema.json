{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roboguide.local-execution-recovery/v0.1",
  "$comment": "Registration consumers additionally enforce an 8192-byte encoded limit, unique exact operation identities, canonical identity grammar and declaring LocalSystem ownership.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operations"],
  "properties": {
    "schema_version": {"const": "roboguide.local-execution-recovery/v0.1"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "stop_scope", "continuation"],
        "properties": {
          "operation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespace", "name", "version"],
            "properties": {
              "namespace": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          },
          "stop_scope": {"enum": ["execution", "execution-group", "unsupported"]},
          "continuation": {"enum": ["repeat-after-stop", "unsupported"]}
        },
        "allOf": [{
          "if": {"properties": {"stop_scope": {"const": "unsupported"}}},
          "then": {"properties": {"continuation": {"const": "unsupported"}}}
        }]
      }
    }
  }
}
