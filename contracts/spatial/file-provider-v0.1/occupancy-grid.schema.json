{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "roboguide.occupancy-grid/v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "width",
    "height",
    "resolution",
    "origin",
    "cells"
  ],
  "properties": {
    "schema_version": {
      "const": "roboguide.occupancy-grid/v0.1"
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "resolution": {
      "type": "number",
      "minimum": 0.0001,
      "maximum": 1000
    },
    "origin": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": -1000000,
        "maximum": 1000000
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": {
        "type": "integer",
        "minimum": -1,
        "maximum": 100
      }
    }
  }
}
