{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "roboguide.spatial-file-job/v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "frame_id",
    "inputs",
    "policy"
  ],
  "properties": {
    "schema_version": {
      "const": "roboguide.spatial-file-job/v0.1"
    },
    "job_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "frame_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "path",
          "content_digest",
          "frame_id",
          "units",
          "format"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "content_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "frame_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "units": {
            "enum": [
              "m",
              "cm",
              "mm"
            ]
          },
          "format": {
            "enum": [
              "pcd",
              "ply"
            ]
          }
        }
      }
    },
    "parent": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "content_digest",
            "revision_id",
            "frame_id"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "content_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "revision_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "frame_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voxel_size",
        "normal_radius",
        "feature_radius",
        "ransac_distance",
        "icp_distance",
        "min_fitness",
        "max_rmse",
        "min_shape_ratio",
        "max_cycle_translation",
        "max_cycle_angle",
        "tile_size",
        "ransac_trials",
        "ransac_repeats",
        "icp_iterations",
        "seed",
        "max_points",
        "max_total_points",
        "max_downsample_points",
        "max_input_bytes",
        "max_output_bytes",
        "max_tiles",
        "timeout_s",
        "memory_mb",
        "threads"
      ],
      "properties": {
        "voxel_size": {
          "type": "number",
          "minimum": 0.0001,
          "maximum": 10
        },
        "normal_radius": {
          "type": "number",
          "minimum": 0.0002,
          "maximum": 100
        },
        "feature_radius": {
          "type": "number",
          "minimum": 0.0004,
          "maximum": 100
        },
        "ransac_distance": {
          "type": "number",
          "minimum": 0.0001,
          "maximum": 100
        },
        "icp_distance": {
          "type": "number",
          "minimum": 0.0001,
          "maximum": 100
        },
        "min_fitness": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1
        },
        "max_rmse": {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 100
        },
        "min_shape_ratio": {
          "type": "number",
          "minimum": 1e-08,
          "maximum": 0.5
        },
        "max_cycle_translation": {
          "type": "number",
          "minimum": 0.0001,
          "maximum": 100
        },
        "max_cycle_angle": {
          "type": "number",
          "minimum": 0.0001,
          "maximum": 3.141592653589793
        },
        "tile_size": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 1000
        },
        "ransac_trials": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "ransac_repeats": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "icp_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "max_points": {
          "type": "integer",
          "minimum": 3,
          "maximum": 2000000
        },
        "max_total_points": {
          "type": "integer",
          "minimum": 3,
          "maximum": 4000000
        },
        "max_downsample_points": {
          "type": "integer",
          "minimum": 3,
          "maximum": 200000
        },
        "max_input_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 268435456
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 536870912
        },
        "max_tiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 2048,
          "maximum": 32768
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    }
  }
}
