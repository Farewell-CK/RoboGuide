{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboguide.local/contracts/spatial/v0.2/map-publication.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest",
    "execution_id"
  ],
  "properties": {
    "schema": {
      "const": "roboguide.map-publication/v0.1"
    },
    "manifest": {
      "$ref": "map-manifest.schema.json"
    },
    "execution_id": {
