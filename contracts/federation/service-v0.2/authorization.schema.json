{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboguide.dev/contracts/federation/service-v0.2/authorization.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "revision",
    "local_domain",
    "domain_epochs",
    "grants"
  ],
  "properties": {
    "schema_version": {
      "const": "roboguide.federation-authorization/v0.1"
    },
    "registry_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "local_domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "domain_epochs": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 64,
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 18446744073709551615
      },
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "grants": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 4096,
      "propertyNames": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "principal_id",
          "tenant_ids",
          "domain_ids",
          "revoked"
        ],
        "properties": {
          "principal_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "tenant_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "domain_ids": {
            "type": "array",
            "minItems": 2,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "revoked": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
