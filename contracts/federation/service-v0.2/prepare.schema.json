{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboguide.dev/contracts/federation/service-v0.2/prepare.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session"
  ],
  "properties": {
    "schema_version": {
      "const": "roboguide.federation-service/v0.2"
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_id",
        "source_domain",
        "target_domain",
        "tenant_id",
        "source_epoch",
        "plan_digest",
        "ownership_digest",
        "deadline",
        "state"
      ],
      "properties": {
        "transaction_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "source_domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "target_domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "ownership_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "deadline": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "state": {
          "const": "prepared"
        }
      }
    }
  }
}
