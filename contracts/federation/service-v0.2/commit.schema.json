{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboguide.dev/contracts/federation/service-v0.2/commit.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_epoch",
    "plan_digest",
    "ownership_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "roboguide.federation-service/v0.2"
    },
    "source_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ownership_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
