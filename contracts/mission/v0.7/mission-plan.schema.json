{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboguide.local/contracts/mission/v0.7/mission-plan.schema.json",
  "title": "RoboGuide MissionPlan v0.7",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mission", "contexts", "tasks"],
  "properties": {
    "schema_version": {"const": "roboguide.mission-plan/v0.7"},
    "mission": {
      "type":"object","additionalProperties":false,"required":["id","objective","actors"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},"objective":{"type":"string","minLength":1},
        "actors":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["id"],"properties":{"id":{"$ref":"#/$defs/id"}}}}
      }
    },
    "contexts": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/context"}},
    "tasks": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/task"}}
  },
  "$defs": {
    "id":{"type":"string","minLength":1,"pattern":"^[a-z0-9][a-z0-9._-]*$"},
    "ref":{"type":"object","additionalProperties":false,"required":["namespace","name","version"],"properties":{"namespace":{"type":"string","pattern":"^[^\\s.@]+(?:\\.[^\\s.@]+)*$"},"name":{"type":"string","pattern":"^[^\\s.@]+$"},"version":{"type":"string","pattern":"^[^\\s@]+$"}}},
    "resource":{"type":"object","additionalProperties":false,"required":["kind","units"],"properties":{"kind":{"enum":["space","compute","time"]},"units":{"type":"integer","minimum":1,"maximum":4294967295}}},
    "constraint":{"type":"object","additionalProperties":false,"required":["attribute","operator","value"],"properties":{"attribute":{"type":"string","minLength":1},"operator":{"enum":["equals","at-least","at-most"]},"value":{"type":["boolean","integer","number","string"]}}},
    "capability_requirement":{"type":"object","additionalProperties":false,"required":["contract","constraints"],"properties":{"contract":{"$ref":"#/$defs/ref"},"constraints":{"type":"array","items":{"$ref":"#/$defs/constraint"}}}},
    "role":{"type":"object","additionalProperties":false,"required":["id","context_role","requirements","execution_intent","resource_scope"],"properties":{
      "id":{"$ref":"#/$defs/id"},"context_role":{"$ref":"#/$defs/id"},"resource_scope":{"enum":["task","context"]},
      "requirements":{"type":"object","additionalProperties":false,"required":["capabilities","resources"],"properties":{"capabilities":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/capability_requirement"}},"resources":{"type":"array","maxItems":3,"items":{"$ref":"#/$defs/resource"}}}},
      "execution_intent":{"type":"object","additionalProperties":false,"required":["operation","objective","parameters"],"properties":{"operation":{"$ref":"#/$defs/ref"},"objective":{"type":"string","minLength":1},"parameters":{"type":"object","additionalProperties":{"type":["boolean","integer","number","string"]}}}}
    }},
    "timing":{"type":"object","additionalProperties":false,"required":["earliest_start_offset_ms","latest_start_offset_ms","completion_deadline_offset_ms"],"properties":{"earliest_start_offset_ms":{"type":"integer","minimum":0,"maximum":18446744073709551615},"latest_start_offset_ms":{"type":["integer","null"],"minimum":0,"maximum":18446744073709551615},"completion_deadline_offset_ms":{"type":["integer","null"],"minimum":0,"maximum":18446744073709551615}}},
    "satisfaction":{"type":"object","additionalProperties":false,"required":["expected_effect","basis","verifier"],"properties":{
      "expected_effect":{"type":"string","minLength":1},"basis":{"enum":["execution-report","verifier-evidence"]},
      "verifier":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["contract","predicate","max_evidence_age_ms"],"properties":{"contract":{"$ref":"#/$defs/ref"},"predicate":{"type":"string","minLength":1},"max_evidence_age_ms":{"type":"integer","minimum":1,"maximum":18446744073709551615}}}]}
    }},
    "endpoint":{"type":"object","additionalProperties":false,"required":["task_id","role_id"],"properties":{"task_id":{"$ref":"#/$defs/id"},"role_id":{"$ref":"#/$defs/id"}}},
    "spatial_reference":{"type":"object","additionalProperties":false,"required":["map_id","revision_id","frame_id"],"properties":{"map_id":{"type":"string","minLength":1},"revision_id":{"type":"string","minLength":1},"frame_id":{"type":"string","minLength":1}}},
    "relation":{"type":"object","additionalProperties":false,"required":["id","kind","source","target"],"properties":{"id":{"$ref":"#/$defs/id"},"kind":{"enum":["requires-active","group-member-state","shared-spatial-reference","relative-pose","relative-distance","state-requirement","freshness-requirement"]},"state_key":{"type":"string","minLength":1},"reference":{"$ref":"#/$defs/spatial_reference"},"frame_id":{"type":"string","minLength":1},"requirement":{"enum":["available","unavailable"]},"policy_id":{"type":"string","minLength":1},"source":{"$ref":"#/$defs/endpoint"},"target":{"$ref":"#/$defs/endpoint"}}},
    "shared_view":{"type":"object","additionalProperties":false,"required":["bindings","include_freshness"],"properties":{"spatial_reference":{"anyOf":[{"$ref":"#/$defs/spatial_reference"},{"type":"null"}]},"include_freshness":{"type":"boolean"},"bindings":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["context_role_id","field"],"properties":{"context_role_id":{"$ref":"#/$defs/id"},"field":{"enum":["pose","velocity","execution"]},"state_export_id":{"type":"string","minLength":1},"payload_schema":{"type":"string","minLength":1}}}}}},
    "peer_channel":{"type":"object","additionalProperties":false,"required":["profile_id","message_schema"],"properties":{"profile_id":{"$ref":"#/$defs/id"},"message_schema":{"type":"string","minLength":1}}},
    "context":{"type":"object","additionalProperties":false,"required":["id","roles","relations"],"properties":{"id":{"$ref":"#/$defs/id"},"roles":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","actor"],"properties":{"id":{"$ref":"#/$defs/id"},"actor":{"$ref":"#/$defs/id"}}}},"relations":{"type":"array","items":{"$ref":"#/$defs/relation"}},"coupling_mode":{"enum":["independent","sequential-handoff","concurrent-cooperation","tightly-coupled-cooperation"]},"shared_view":{"$ref":"#/$defs/shared_view"},"peer_channel":{"$ref":"#/$defs/peer_channel"}}},
    "task":{"type":"object","additionalProperties":false,"required":["id","description","context_id","depends_on","roles","timing","satisfaction"],"properties":{"id":{"$ref":"#/$defs/id"},"description":{"type":"string","minLength":1},"context_id":{"$ref":"#/$defs/id"},"depends_on":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"roles":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/role"}},"coupling_mode":{"enum":["independent","sequential-handoff","concurrent-cooperation","tightly-coupled-cooperation"]},"timing":{"$ref":"#/$defs/timing"},"satisfaction":{"$ref":"#/$defs/satisfaction"}}}
  }
}
