{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboguide.local/contracts/mission/grounding-context-v0.2/grounding-context.schema.json",
  "title": "RoboGuide Mission Grounding Context v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_digest",
    "request_id",
    "dialogue_digest",
    "captured_at_ms",
    "selection_policy_ref",
    "state_evidence",
    "memory_evidence",
    "gaps",
    "semantic_evidence"
  ],
  "properties": {
    "schema_version": {"const": "roboguide.grounding-context/v0.2"},
    "context_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "request_id": {"type": "string", "minLength": 1},
    "dialogue_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "captured_at_ms": {"type": "integer", "minimum": 0},
    "selection_policy_ref": {"type": "string", "minLength": 1},
    "state_evidence": {
      "type": "array",
      "items": {"$ref": "../grounding-context-v0.1/grounding-context.schema.json#/$defs/state_evidence"}
    },
    "memory_evidence": {
      "type": "array",
      "items": {"$ref": "../grounding-context-v0.1/grounding-context.schema.json#/$defs/memory_evidence"}
    },
    "gaps": {
      "type": "array",
      "items": {"$ref": "../grounding-context-v0.1/grounding-context.schema.json#/$defs/gap"}
    },
    "semantic_evidence": {
      "oneOf": [
        {"$ref": "#/$defs/semantic_evidence"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "semantic_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "authority", "identity", "objective_scope", "goal", "world_context", "digest"],
      "properties": {
        "schema_version": {"const": "roboguide.authoritative-semantic-evidence/v0.1"},
        "authority": {"const": "environment-authoritative"},
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["run_id", "episode_id", "revision"],
          "properties": {
            "run_id": {"type": "string", "minLength": 1},
            "episode_id": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "minLength": 1}
          }
        },
        "objective_scope": {"const": "joint_terminal_state"},
        "goal": {"$ref": "#/$defs/expression"},
        "world_context": {"type": "object"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "arguments"],
          "properties": {
            "kind": {"const": "predicate"},
            "name": {"type": "string", "minLength": 1},
            "arguments": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operator", "operands", "quantifier", "variables"],
          "properties": {
            "kind": {"const": "logical"},
            "operator": {"enum": ["and", "or", "nand", "nor"]},
            "operands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/expression"}},
            "quantifier": {"type": ["string", "null"]},
            "variables": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }
      ]
    }
  }
}
