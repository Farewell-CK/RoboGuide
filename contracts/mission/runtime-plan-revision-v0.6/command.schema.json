{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboguide.dev/contracts/mission/runtime-plan-revision-v0.6/command.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "expected_revision",
    "action"
  ],
  "properties": {
    "schema_version": {
      "const": "roboguide.runtime-plan-revision/v0.6"
    },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ticket_id",
        "authorization"
      ],
      "properties": {
        "kind": {
          "const": "authorize-coordination"
        },
        "ticket_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "kind",
            "beneficiary_mission_id",
            "stop_assurance",
            "continuation_operations",
            "reason"
          ],
          "properties": {
            "schema": {
              "const": "roboguide.execution-coordination/v0.1"
            },
            "kind": {
              "enum": [
                "running-preemption",
                "coupled-recovery",
                "handoff",
                "regrasp"
              ]
            },
            "beneficiary_mission_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256
            },
            "stop_assurance": {
              "enum": [
                "software-process",
                "device-observation"
              ]
            },
            "continuation_operations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "namespace",
                  "name",
                  "version"
                ],
                "properties": {
                  "namespace": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "running-preemption"
                  }
                }
              },
              "then": {
                "properties": {
                  "beneficiary_mission_id": {
                    "type": "string"
                  }
                }
              },
              "else": {
                "properties": {
                  "beneficiary_mission_id": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "enum": [
                      "handoff",
                      "regrasp"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "stop_assurance": {
                    "const": "device-observation"
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
