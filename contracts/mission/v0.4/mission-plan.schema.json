{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboguide.local/contracts/mission/v0.4/mission-plan.schema.json",
  "title": "RoboGuide MissionPlan v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mission", "contexts", "tasks"],
  "properties": {
    "schema_version": {"type": "string", "const": "roboguide.mission-plan/v0.4"},
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "objective"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "objective": {"type": "string", "minLength": 1}
      }
    },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "roles", "relations"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "roles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "actor"],
              "properties": {
                "id": {"$ref": "#/$defs/id"},
                "actor": {"$ref": "#/$defs/id"}
              }
            }
          },
          "coupling_mode": {"$ref": "#/$defs/coupling_mode"},
          "shared_view": {"$ref": "#/$defs/shared_view"},
          "peer_channel": {"$ref": "#/$defs/peer_channel"},
          "relations": {
            "type": "array",
            "items": {"$ref": "#/$defs/relation"}
          }
        },
        "allOf": [
          {
            "if": {"properties": {"coupling_mode": {"enum": ["concurrent-cooperation", "tightly-coupled-cooperation"]}}, "required": ["coupling_mode"]},
            "then": {"required": ["shared_view"], "properties": {"relations": {"minItems": 1}}}
          },
          {
            "if": {"properties": {"coupling_mode": {"const": "tightly-coupled-cooperation"}}, "required": ["coupling_mode"]},
            "then": {"required": ["peer_channel"]}
          }
        ]
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "context_id", "depends_on", "roles"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "description": {"type": "string", "minLength": 1},
          "context_id": {"$ref": "#/$defs/id"},
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/id"}
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/role"}
          },
          "coupling_mode": {"$ref": "#/$defs/coupling_mode"}
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "name", "version"],
      "properties": {
        "namespace": {"type": "string", "pattern": "^[^\\s.@]+(?:\\.[^\\s.@]+)*$"},
        "name": {"type": "string", "pattern": "^[^\\s.@]+$"},
        "version": {"type": "string", "pattern": "^[^\\s@]+$"}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "role_id"],
      "properties": {
        "task_id": {"$ref": "#/$defs/id"},
        "role_id": {"$ref": "#/$defs/id"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source", "target"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["requires-active", "group-member-state", "shared-spatial-reference", "relative-pose", "relative-distance", "state-requirement", "freshness-requirement"]},
        "state_key": {"type": "string", "minLength": 1},
        "reference": {"$ref": "#/$defs/spatial_reference"},
        "frame_id": {"type": "string", "minLength": 1},
        "requirement": {"enum": ["available", "unavailable"]},
        "policy_id": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/endpoint"},
        "target": {"$ref": "#/$defs/endpoint"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "group-member-state"}}}, "then": {"required": ["state_key"]}},
        {"if": {"properties": {"kind": {"const": "shared-spatial-reference"}}}, "then": {"required": ["reference"]}},
        {"if": {"properties": {"kind": {"enum": ["relative-pose", "relative-distance"]}}}, "then": {"required": ["frame_id"]}},
        {"if": {"properties": {"kind": {"const": "state-requirement"}}}, "then": {"required": ["state_key", "requirement"]}},
        {"if": {"properties": {"kind": {"const": "freshness-requirement"}}}, "then": {"required": ["state_key", "policy_id"]}}
      ]
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "actor", "capability", "contract", "resource_kind",
        "execution", "context_role", "resource_scope"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "actor": {"$ref": "#/$defs/id"},
        "capability": {"enum": ["mobility", "transport", "compute", "observation"]},
        "contract": {"$ref": "#/$defs/contract"},
        "resource_kind": {"enum": ["space", "compute", "time", null]},
        "context_role": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "resource_scope": {"enum": ["task", "context"]},
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capability_contract", "parameters"],
          "properties": {
            "capability_contract": {"$ref": "#/$defs/contract"},
            "parameters": {
              "type": "object",
              "additionalProperties": {"type": ["boolean", "integer", "number", "string"]}
            }
          }
        }
      }
    },
    "coupling_mode": {
      "enum": ["independent", "sequential-handoff", "concurrent-cooperation", "tightly-coupled-cooperation"]
    },
    "spatial_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["map_id", "revision_id", "frame_id"],
      "properties": {
        "map_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "revision_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "frame_id": {"type": "string", "minLength": 1}
      }
    },
    "shared_view": {
      "type": "object", "additionalProperties": false,
      "required": ["bindings", "include_freshness"],
      "properties": {
        "spatial_reference": {"anyOf": [{"$ref": "#/$defs/spatial_reference"}, {"type": "null"}]},
        "bindings": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["context_role_id", "field"],
            "properties": {
              "context_role_id": {"$ref": "#/$defs/id"},
              "field": {"enum": ["pose", "velocity", "execution"]},
              "state_export_id": {"type": "string", "minLength": 1},
              "payload_schema": {"type": "string", "minLength": 1}
            },
            "allOf": [
              {"if": {"properties": {"field": {"enum": ["pose", "velocity"]}}}, "then": {"required": ["state_export_id", "payload_schema"]}},
              {"if": {"properties": {"field": {"const": "execution"}}}, "then": {"not": {"anyOf": [{"required": ["state_export_id"]}, {"required": ["payload_schema"]}]}}}
            ]
          }
        },
        "include_freshness": {"type": "boolean"}
      }
    },
    "peer_channel": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "message_schema"],
      "properties": {"profile_id": {"$ref": "#/$defs/id"}, "message_schema": {"type": "string", "minLength": 1}}
    }
  }
}
