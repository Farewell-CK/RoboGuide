{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboguide.local/contracts/mission/request-v0.4/mission-request.schema.json",
  "title": "RoboGuide Mission Request v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "mission_id",
    "dialogue",
    "lifecycle",
    "assessment",
    "plan",
    "grounding_context",
    "draft_revision",
    "draft_digest",
    "approval_required",
    "approval_reasons",
    "issues",
    "repair_attempts",
    "review_history",
    "created_at_ms",
    "updated_at_ms"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "roboguide.mission-request/v0.4"},
    "request_id": {"type": "string", "pattern": "^request-[a-f0-9]{32}$"},
    "mission_id": {"type": "string", "pattern": "^mission-[a-f0-9]{32}$"},
    "dialogue": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/dialogue_turn"}
    },
    "lifecycle": {
      "enum": [
        "Received",
        "Interpreting",
        "NeedsClarification",
        "Drafted",
        "Reviewing",
        "Repairing",
        "AwaitingApproval",
        "Submitting",
        "Accepted",
        "Blocked",
        "Failed",
        "Cancelled"
      ]
    },
    "assessment": {
      "oneOf": [{"$ref": "#/$defs/assessment"}, {"type": "null"}]
    },
    "plan": {
      "oneOf": [
        {"$ref": "../v0.3/mission-plan.schema.json"},
        {"$ref": "../v0.4/mission-plan.schema.json"},
        {"$ref": "../v0.5/mission-plan.schema.json"},
        {"$ref": "../v0.6/mission-plan.schema.json"},
        {"$ref": "../v0.7/mission-plan.schema.json"},
        {"type": "null"}
      ]
    },
    "grounding_context": {
      "oneOf": [
        {"$ref": "../grounding-context-v0.1/grounding-context.schema.json"},
        {"type": "null"}
      ]
    },
    "draft_revision": {"type": "integer", "minimum": 0},
    "draft_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "approval_required": {"type": "boolean"},
    "approval_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "issues": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "repair_attempts": {"type": "integer", "minimum": 0},
    "review_history": {"type": "array", "items": {"$ref": "#/$defs/review_attempt"}},
    "created_at_ms": {"type": "integer", "minimum": 0},
    "updated_at_ms": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "dialogue_turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn_id",
        "speaker",
        "kind",
        "content",
        "created_at_ms",
        "in_reply_to"
      ],
      "properties": {
        "turn_id": {"type": "string", "minLength": 1},
        "speaker": {"enum": ["User", "MissionIntelligence"]},
        "kind": {"enum": ["Instruction", "ClarificationQuestion", "ClarificationAnswer"]},
        "content": {"type": "string", "minLength": 1},
        "created_at_ms": {"type": "integer", "minimum": 0},
        "in_reply_to": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "constraints", "assumptions", "open_questions"],
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "review_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "message", "required_action"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "path": {"type": "string", "pattern": "^/"},
        "message": {"type": "string", "minLength": 1},
        "required_action": {"enum": ["RepairPlan", "RequestClarification", "RejectDraft"]}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "issues"],
      "properties": {
        "approved": {"type": "boolean"},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/review_issue"}}
      }
    },
    "review_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draft_revision",
        "draft_digest",
        "grounding_context_digest",
        "review",
        "reviewed_at_ms"
      ],
      "properties": {
        "draft_revision": {"type": "integer", "minimum": 1},
        "draft_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "grounding_context_digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "review": {"$ref": "#/$defs/review"},
        "reviewed_at_ms": {"type": "integer", "minimum": 0}
      }
    }
  }
}
