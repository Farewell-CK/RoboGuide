{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "input_dialogue_digest",
    "request_record_digest",
    "configuration",
    "configuration_digest",
    "grounding_context_digest",
    "draft_revision",
    "lifecycle",
    "provider_calls",
    "deliberation_active"
  ],
  "properties": {
    "schema_version": {
      "const": "roboguide.mission-provenance/v0.1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "input_dialogue_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "request_record_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "configuration": {
      "type": "object"
    },
    "configuration_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "grounding_context_digest": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "draft_revision": {
      "type": "integer",
      "minimum": 0
    },
    "lifecycle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "provider_calls": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "call_id",
          "requested_model",
          "observed_model",
          "response_id",
          "request_digest",
          "response_digest",
          "started_at_ms",
          "finished_at_ms",
          "error_type"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "call_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "requested_model": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "observed_model": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "response_id": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "request_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "response_digest": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "started_at_ms": {
            "type": "integer",
            "minimum": 0
          },
          "finished_at_ms": {
            "type": "integer",
            "minimum": 0
          },
          "requested_service_tier": { "$ref": "#/$defs/metadata" },
          "observed_service_tier": { "$ref": "#/$defs/metadata" },
          "requested_reasoning_effort": { "$ref": "#/$defs/metadata" },
          "response_schema_name": { "$ref": "#/$defs/metadata" },
          "stage": {
            "enum": ["interpreter", "planner", "reviewer", "repairer", "deployment_recovery"]
          },
          "cache_prefix_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "token_usage": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          },
          "plan_assembly": { "type": "object" },
          "http_timing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "elapsed_ms",
              "headers_received_ms",
              "body_read_ms",
              "http_status_code",
              "upstream_request_id",
              "failure_phase"
            ],
            "properties": {
              "elapsed_ms": { "type": "integer", "minimum": 0 },
              "headers_received_ms": { "type": ["integer", "null"], "minimum": 0 },
              "body_read_ms": { "type": ["integer", "null"], "minimum": 0 },
              "http_status_code": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
              "upstream_request_id": {
                "type": ["string", "null"],
                "pattern": "^[A-Za-z0-9_.:-]{1,256}$"
              },
              "failure_phase": {
                "enum": [null, "awaiting_headers", "reading_body", "http_status", "decoding_response"]
              }
            }
          },
          "error_type": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "deliberation_active": {
      "type": "boolean"
    }
  },
  "$defs": {
    "metadata": { "type": "string", "minLength": 1, "maxLength": 256 }
  }
}
