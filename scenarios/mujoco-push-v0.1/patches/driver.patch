+def _remember_drop(entity_id: str) -> tuple[float, float, float] | None:
+    """松手后记下"物体丢在我夹爪当时的位置"。
+
+    **只读自己臂的末端位姿, 不读物体真值** —— 与 ``_remember`` 的约定一致:
+    记忆里写的是"我把它放在这儿了", 不是从仿真器抄回来的坐标。
+    返回落点 (x, y, z); 读不到末端位姿时返回 None。
+    """
+    world = _state.get("world")
+    if world is None:
+        return None
+    try:
+        tip = world.site_xyz(GRIPPER_SITE)
+    except Exception:  # noqa: BLE001
+        return None
+    _remember(entity_id, float(tip[0]), float(tip[1]), 0.0, "arm-drop")
+    return float(tip[0]), float(tip[1]), float(tip[2])
+
