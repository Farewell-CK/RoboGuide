+def _carried_envelope_r() -> float:
+    """持物时"手里那件东西"的包络半径 (末端到基座 + 余量)。"""
+    world = _state.get("world")
+    if world is None:
+        return 0.0
+    try:
+        tip = world.site_xyz(GRIPPER_SITE)
+        bx, by = _base_xy()
+    except Exception:  # noqa: BLE001
+        return 0.0
+    return math.hypot(tip[0] - bx, tip[1] - by) + ARM_CARRY_MARGIN_M + 0.02
+
