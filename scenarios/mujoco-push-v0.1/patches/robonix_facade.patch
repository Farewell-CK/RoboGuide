+def _destination_candidates(dest: str) -> list[str]:
+    """把模型可能写出的各种写法列成候选名, 逐个去问 scene。
+
+    实测规划侧写过: "目标点 A"(插空格) / "target point E"(翻译成英文) /
+    "goal_a" / "Goal A"。名字是自由文本, 但**注解是一份固定词表** ——
+    与其在提示词里赌模型一字不差, 不如在边界处把这几种写法都试一遍。
+    """
+    base = " ".join(str(dest).split())
+    out: list[str] = []
+
+    def _add(value: str) -> None:
+        value = value.strip()
+        if value and value not in out:
+            out.append(value)
+
+    _add(base)
+    _add(base.replace(" ", ""))
+    _add(base.replace(" ", "_").lower())
+
+    m = re.fullmatch(r"(?:target[\s_\-]*point|goal)[\s_\-]*([A-Za-z0-9]+)", base, re.I)
+    if m:
+        tag = m.group(1)
+        _add(f"goal_{tag.lower()}")
+        _add(f"目标点{tag.upper()}")
+        _add(f"目标点 {tag.upper()}")
+    m2 = re.fullmatch(r"目标点[\s_\-]*([A-Za-z0-9]+)", base)
+    if m2:
+        tag = m2.group(1)
+        _add(f"goal_{tag.lower()}")
+        _add(f"target point {tag.upper()}")
+        _add(f"Goal {tag.upper()}")
+    return out
+
+
+def _resolve_scene_destination(endpoint: str, dest: str) -> tuple[bool, float, float, str, str]:
+    """把地名解析成坐标: 先按原样问 scene, 不吃再按候选写法逐个试。
+
+    返回 ``(reachable, x, y, reason, used_name)``; ``used_name`` 便于日志说明
+    "最后是按哪个写法认出来的"。
+    """
+    last_reason = ""
+    tried: list[str] = []
+    for cand in _destination_candidates(dest):
+        tried.append(cand)
+        try:
+            reachable, x, y, reason = _scene_goal_region(endpoint, cand)
+        except Exception as exc:  # noqa: BLE001
+            last_reason = f"{type(exc).__name__}: {exc}"
+            continue
+        if reachable:
+            return True, x, y, "", cand
+        last_reason = reason or last_reason
+    return False, 0.0, 0.0, (last_reason or f"试过 {tried} 都不在注解里"), dest
+
