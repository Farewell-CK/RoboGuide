+# 物体口语名 -> 共享世界 body 名。**规划侧必须原样保留用户说法**
+# (interpreter 的硬约束: 不得自行发明物理身份), 所以"箱子 -> obs2"这层映射
+# 只能落在执行侧 —— 这一层恰好是唯一知道世界里有哪几个 body 的地方。
+OBJECT_ALIASES: dict[str, str] = {
+    "箱子": "obs2", "纸箱": "obs2", "纸箱子": "obs2", "目标箱": "obs2",
+    "目标箱子": "obs2", "那个箱子": "obs2", "box": "obs2",
+    "木箱": "crate1", "木箱子": "crate1", "crate": "crate1",
+    "小车": "rover", "底盘": "rover", "车": "rover",
+    "机器狗": "dog", "狗": "dog",
+}
+
+
+_OBJECT_ALIAS_CACHE: dict[str, Any] = {"stamp": None, "table": None, "bodies": None}
+
+
+def _object_alias_table() -> tuple[dict[str, str], dict[str, str]]:
+    """读**场景资产**里的别名表 (``object-aliases.json``), 缺文件时退回内置表。
+
+    为什么放资产里: 别名与场景同代(换场地只换文件, 不改代码), 也让"这张表
+    有多长"变成部署问题而不是代码问题。路径: ``RBNX_OBJECT_ALIASES``,
+    或 ``RBNX_ARENA_MAP`` 同目录下的 ``object-aliases.json``。
+    """
+    arena = os.environ.get("RBNX_ARENA_MAP", "")
+    path = os.environ.get("RBNX_OBJECT_ALIASES") or (
+        os.path.join(os.path.dirname(arena), "object-aliases.json") if arena else "")
+    stamp = None
+    if path:
+        try:
+            stamp = (path, os.path.getmtime(path))
+        except OSError:
+            stamp = (path, None)
+    if _OBJECT_ALIAS_CACHE["stamp"] == stamp and _OBJECT_ALIAS_CACHE["table"] is not None:
+        return _OBJECT_ALIAS_CACHE["table"], _OBJECT_ALIAS_CACHE["bodies"]
+    aliases = {k.replace(" ", "").lower(): v for k, v in OBJECT_ALIASES.items()}
+    bodies: dict[str, str] = {}
+    if path and stamp and stamp[1] is not None:
+        try:
+            with open(path, encoding="utf-8") as _fh:
+                doc = json.load(_fh)
+            for body, meta in (doc.get("bodies") or {}).items():
+                bodies[str(body)] = str(meta.get("label") or body)
+                aliases[str(body).replace(" ", "").lower()] = str(body)
+                for alias in (meta.get("aliases") or []):
+                    aliases[str(alias).replace(" ", "").lower()] = str(body)
+        except (OSError, ValueError, KeyError, AttributeError, TypeError):
+            bodies = {}
+    _OBJECT_ALIAS_CACHE.update({"stamp": stamp, "table": aliases, "bodies": bodies})
+    return aliases, bodies
+
+
+# 描述词 -> 形状。用于"不靠别名表"的匹配: 用户说"那个方块/圆柱"也能筛。
+_SHAPE_WORDS: dict[str, str] = {
+    "方块": "box", "方形": "box", "方盒": "box", "盒子": "box", "箱": "box",
+    "cube": "box", "block": "box",
+    "圆柱": "cylinder", "柱子": "cylinder", "圆筒": "cylinder", "cylinder": "cylinder",
+    "球": "sphere", "圆球": "sphere", "球形": "sphere", "sphere": "sphere",
+}
+# colour_hist 的 12 个色相桶 -> 中文色名(粗粒度, 只用于筛"那个绿色的东西")
+_HUE_NAMES = ("红", "橙", "黄", "黄绿", "绿", "青绿",
+              "青", "天蓝", "蓝", "紫", "洋红", "玫红")
+_COLOUR_WORDS = {name: idx for idx, name in enumerate(_HUE_NAMES)}
+
+
+def _object_descriptors(body: str, meta: dict) -> dict[str, Any]:
+    """一个物体的"可描述特征": 形状 / 颜色 / 是否可搬 / 说明文字。"""
+    hist = meta.get("colour_hist") or []
+    colour = ""
+    if isinstance(hist, list) and hist:
+        try:
+            idx = max(range(len(hist)), key=lambda i: float(hist[i]))
+            if float(hist[idx]) >= 0.25 and idx < len(_HUE_NAMES):
+                colour = _HUE_NAMES[idx]
+        except (TypeError, ValueError):
+            colour = ""
+    return {
+        "shape": str(meta.get("geom") or ""),
+        "colour": colour,
+        "movable": bool(meta.get("movable")),
+        "note": str(meta.get("note") or ""),
+    }
+
+
+def _match_objects_by_description(text: str) -> list[tuple[str, str]]:
+    """按"描述"筛可搬物体, **不依赖别名表**。
+
+    规则刻意保守: 只对 ``movable=True`` 的实体做筛选; 用户提到的每个特征
+    (形状词/颜色词)都必须与候选一致, 否则该候选被排除。
+    返回 ``[(body, label), ...]``; 长度为 1 才算"确定", 否则调用方应当反问。
+    """
+    raw = (text or "").strip().lower()
+    if not raw:
+        return []
+    wanted_shape = next((v for k, v in _SHAPE_WORDS.items() if k in raw), "")
+    wanted_colour = next((k for k in _COLOUR_WORDS if k in raw), "")
+    if not wanted_shape and not wanted_colour:
+        return []
+    scene = _scene() or {}
+    _aliases, labels = _object_alias_table()
+    out: list[tuple[str, str]] = []
+    for name, meta in scene.items():
+        if not isinstance(meta, dict):
+            continue
+        desc = _object_descriptors(str(name), meta)
+        if not desc["movable"]:
+            continue
+        if wanted_shape and desc["shape"] != wanted_shape:
+            continue
+        if wanted_colour and desc["colour"] != wanted_colour:
+            continue
+        out.append((str(name), labels.get(str(name), str(name))))
+    return out
+
+
+def _object_choices() -> str:
+    """可搬物体的"选择题"文本, 用于认不出时回给上游。"""
+    _aliases, bodies = _object_alias_table()
+    if not bodies:
+        return "、".join(sorted(set(OBJECT_ALIASES.values())))
+    return "、".join(f"{body}({label})" for body, label in bodies.items())
+
+
+def _resolve_object_name(obj: str, world: Any = None) -> tuple[str, str, bool]:
+    """把用户口语化的物体名归一成共享世界 body 名。
+
+    返回 ``(body_name, note, known)``:
+      · ``note`` 非空表示发生过归一(会打日志);
+      · ``known=False`` 表示既不是别名、也不是场景里的实体 —— 调用方应当
+        **带着候选列表拒绝**, 而不是把口语原样丢给 provider。
+    """
+    raw = (obj or "").strip()
+    if not raw:
+        return raw, "", False
+    key = raw.replace(" ", "").lower()
+    aliases, _bodies = _object_alias_table()
+    hit = aliases.get(key)
+    if hit is not None:
+        return hit, ("" if hit == raw else f"{raw}→{hit}"), True
+    if raw in _bodies:
+        return raw, "", True
+    try:
+        # `_scene_entity` 对未知名字返回 **空 dict**（不是 None），
+        # 之前用 `is not None` 判断 → 永远 True → "认不出"分支永远走不到（实测）。
+        _entry = _scene_entity(raw) or {}
+        if _entry and ("pos" in _entry or "kind" in _entry):
+            return raw, "", True
+    except Exception:  # noqa: BLE001
+        pass
+    # **描述式匹配**(不靠别名表): 用户说"那个方块/绿色的东西"时,
+    # 用场景里已有的 geom / colour / movable 特征筛; **只有唯一命中才敢用**,
+    # 多个或零个都交给调用方反问候选。
+    try:
+        matched = _match_objects_by_description(raw)
+    except Exception:  # noqa: BLE001
+        matched = []
+    if len(matched) == 1:
+        body, label = matched[0]
+        return body, f"{raw}≈>{body}(按描述匹配: {label})", True
+    return raw, "", False
+
