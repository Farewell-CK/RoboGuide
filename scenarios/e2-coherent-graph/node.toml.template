schema = "roboguide.node-config/v0.7"
node_id = "NODE_ID_PLACEHOLDER"
server_endpoint = "http://127.0.0.1:25070"
state_directory = "STATE_DIRECTORY_PLACEHOLDER"
reconnect_delay_ms = 250

[[local_systems]]
id = "LOCAL_SYSTEM_PLACEHOLDER"
runtime_name = "coherent-public-graph"
runtime_version = "e2-s1"

[local_systems.metadata]
"roboguide.execution-recovery" = '''{"schema_version":"roboguide.local-execution-recovery/v0.1","operations":[{"operation":{"namespace":"coherent","name":"RECOVERY_OPERATION_PLACEHOLDER","version":"v1"},"stop_scope":"execution","continuation":"repeat-after-stop"}]}'''

[local_systems.health]
state_pointer = "/state"
detail_pointer = "/detail"
online = ["ONLINE"]
degraded = ["DEGRADED"]
offline = ["OFFLINE"]

[local_systems.health.step]
id = "coherent-graph-health"
connection = "coherent-graph-http"

[local_systems.health.step.operation]
kind = "http"
method = "GET"
path = "/v1/health"

[local_systems.health.step.request]
base = {}

[[connections]]
driver = "http"
id = "coherent-graph-http"
local_system = "LOCAL_SYSTEM_PLACEHOLDER"
endpoint = "http://127.0.0.1:28120"
timeout_ms = 5000

[[capability_profiles]]
contract = "CONTRACT_PLACEHOLDER"
kind = "transport"
owner = "LOCAL_SYSTEM_PLACEHOLDER"
attributes = {}

[capability_profiles.readiness]
state_pointer = "/state"
detail_pointer = "/detail"
ready = ["READY"]
unavailable = ["UNAVAILABLE"]

[capability_profiles.readiness.step]
id = "coherent-graph-readiness"
connection = "coherent-graph-http"

[capability_profiles.readiness.step.operation]
kind = "http"
method = "GET"
path = "/v1/capabilities/READINESS_PLACEHOLDER"

[capability_profiles.readiness.step.request]
base = {}

[[resources]]
id = "RESOURCE_PLACEHOLDER"
kind = "space"
capacity = 1
owner = "LOCAL_SYSTEM_PLACEHOLDER"

[[operations]]
operation = "CONTRACT_PLACEHOLDER"
owner = "LOCAL_SYSTEM_PLACEHOLDER"
required_resources = ["RESOURCE_PLACEHOLDER"]
local_locks = ["LOCK_PLACEHOLDER"]

[operations.workflow]
poll_interval_ms = 100

[operations.workflow.local_handle]
kind = "pointer"
pointer = "/steps/dispatch/execution_id"

[operations.workflow.execution_state]
state_pointer = "/steps/status/state"
reason_pointer = "/steps/status/detail"
accepted = ["ACCEPTED"]
running = ["RUNNING"]
completed = ["COMPLETED"]
failed = ["FAILED"]
cancelled = ["CANCELLED"]
case_sensitive = false

[[operations.workflow.execute]]
id = "dispatch"
connection = "coherent-graph-http"

[operations.workflow.execute.operation]
kind = "http"
method = "POST"
path = "/v1/executions"

[operations.workflow.execute.request]
base = {}

[[operations.workflow.execute.request.bindings]]
target = "/invocation"

[operations.workflow.execute.request.bindings.value]
kind = "pointer"
pointer = "/invocation"

[[operations.workflow.execute.request.bindings]]
target = "/invocation/attempt_id"

[operations.workflow.execute.request.bindings.value]
kind = "pointer"
pointer = "/attempt_id"

[[operations.workflow.status]]
id = "status"
connection = "coherent-graph-http"

[operations.workflow.status.operation]
kind = "http"
method = "POST"
path = "/v1/executions/status"

[operations.workflow.status.request]
base = {}

[[operations.workflow.status.request.bindings]]
target = "/execution_id"

[operations.workflow.status.request.bindings.value]
kind = "pointer"
pointer = "/local_handle"

[[operations.workflow.cancel]]
id = "cancel"
connection = "coherent-graph-http"

[operations.workflow.cancel.operation]
kind = "http"
method = "POST"
path = "/v1/executions/cancel"

[operations.workflow.cancel.request]
base = {}

[[operations.workflow.cancel.request.bindings]]
target = "/execution_id"

[operations.workflow.cancel.request.bindings.value]
kind = "pointer"
pointer = "/local_handle"
